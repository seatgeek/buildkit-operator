{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'mergeConfidence:all-badges',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  minimumReleaseAge: '7 days',
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  dependencyDashboard: true,
  osvVulnerabilityAlerts: true,
  dependencyDashboardOSVVulnerabilitySummary: 'all',
  vulnerabilityAlerts: {
    labels: [
      'security',
    ],
  },
  reviewers: [
    'team:cloud-platform',
  ],
  reviewersSampleSize: 1,
  gomod: {
    postUpdateOptions: [
      'gomodUpdateImportPaths',
      'gomodTidy',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\n[^\\s]+?_VERSION\\s*\\??=\\s*"?(?<currentValue>.+?)"?\\n',
      ],
    },
  ],
  packageRules: [
    {
      description: "Don't bother with replaced internal package",
      matchPackageNames: [
        'github.com/seatgeek/buildkit-operator/api',
      ],
      enabled: false,
    },
    {
      description: 'Limit noisy updates to once per week',
      matchUpdateTypes: [
        'digest',
        'lockFileMaintenance',
      ],
      extends: [
        'schedule:weekly',
      ],
    },
    {
      description: 'Auto-merge non-major test deps (file-based)',
      matchFileNames: [
        'Makefile',
        '.github/**/*.yml',
        '.github/**/*.yaml',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Update CI and Makefile tooling during the first week of each month (k8s.io deps follow the kubernetes group instead)',
      matchManagers: [
        'github-actions',
        'custom.regex',
      ],
      matchPackageNames: [
        '!k8s.io/**',
      ],
      schedule: [
        '* * 1-7 * *',
      ],
    },
    {
      description: 'Batch GitHub Actions version updates into a single PR; digest and pin updates stay separate so they cannot block or un-automerge the batch',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      groupName: 'GitHub Actions',
    },
    {
      description: 'Require approval for GitHub Actions digest changes that have no new version tag',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: 'Auto-merge non-major test deps (package-based)',
      matchPackageNames: [
        'github.com/onsi/ginkgo/v2',
        'github.com/onsi/gomega',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Group yq updates together',
      matchPackageNames: [
        '/\\bmikefarah\\/yq\\b',
      ],
      groupName: 'mikefarah/yq',
    },
    {
      "description": "Offer to bump Golang versions in a single MR",
      "matchDepNames": [
        "go",
        "golang",
        "golang/go",
        "github.com/golang/go",
        "docker.io/library/golang",
      ],
      "enabled": true,
      "rangeStrategy": "bump",
      "groupName": "Golang"
    },
    {
      "matchDepNames": ["go"],
      "matchFileNames": ["**/go.mod"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Never bump the api module's Go directive: it is a compatibility floor for downstream consumers, not an internal setting. Raise it by hand when code there needs a newer feature.",
      "matchDepNames": ["go"],
      "matchFileNames": ["api/go.mod"],
      "enabled": false
    },
    {
      "description": "Offer separate minor and patch updates for certain deps",
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**", "github.com/kubernetes-sigs/**", "kubectl{/,}**", "rancher/kubectl{/,}**", "kubernetes/**", "github.com/reddit/**"],
      "separateMultipleMajor": true,
      "separateMultipleMinor": true,
      "separateMinorPatch": true
    },
    {
      "description": "Hold certain non-patch infra-related deps until we're ready",
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**", "github.com/kubernetes-sigs/**", "kubectl{/,}**", "rancher/kubectl{/,}**", "kubernetes/**", "github.com/reddit/**"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group kubernetes updates together",
      "matchManagers": ["gomod", "custom.regex"],
      "matchPackageNames": ["k8s.io/**"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "kubernetes packages",
      "groupSlug": "kubernetes-go"
    },
    {
      "description": "Upgrade all kubernetes dependencies, including indirect ones",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Auto-merge patch updates to kubernetes packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "rebaseWhen": "auto"
    },
  ],
}
