{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'mergeConfidence:all-badges',
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  dependencyDashboard: true,
  osvVulnerabilityAlerts: true,
  dependencyDashboardOSVVulnerabilitySummary: 'all',
  vulnerabilityAlerts: {
    labels: [
      'security',
    ],
  },
  reviewers: [
    'team:developer-experience',
  ],
  reviewersSampleSize: 1,
  gomod: {
    postUpdateOptions: [
      'gomodUpdateImportPaths',
      'gomodTidy',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\n[^\\s]+?_VERSION\\s*\\??=\\s*"?(?<currentValue>.+?)"?\\n',
      ],
    },
  ],
  packageRules: [
    {
      description: "Don't bother with replaced internal package",
      matchPackageNames: [
        'github.com/seatgeek/buildkit-operator/api',
      ],
      enabled: false,
    },
    {
      description: 'Limit noisy updates to once per week',
      matchUpdateTypes: [
        'digest',
        'lockFileMaintenance',
      ],
      extends: [
        'schedule:weekly',
      ],
    },
    {
      description: 'Auto-merge non-major test deps (file-based)',
      matchFileNames: [
        'Makefile',
        '.github/**/*.yml',
        '.github/**/*.yaml',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Auto-merge non-major test deps (package-based)',
      matchPackageNames: [
        'github.com/onsi/ginkgo/v2',
        'github.com/onsi/gomega',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Group yq updates together',
      matchPackageNames: [
        '/\\bmikefarah\\/yq\\b',
      ],
      groupName: 'mikefarah/yq',
    },
    {
      description: 'Group go updates together',
      matchPackageNames: ['go', 'golang'],
      groupName: 'go',
    },
    {
      "description": "Offer separate minor and patch updates for certain deps",
      "matchPackagePrefixes": ["k8s.io/", "sigs.k8s.io/", "github.com/kubernetes-sigs/", "kubectl", "rancher/kubectl", "kubernetes/", "github.com/reddit/"],
      "separateMultipleMajor": true,
      "separateMultipleMinor": true,
      "separateMinorPatch": true
    },
    {
      "description": "Hold certain non-patch infra-related deps until we're ready",
      "matchPackagePrefixes": ["k8s.io/", "sigs.k8s.io/", "github.com/kubernetes-sigs/", "kubectl", "rancher/kubectl", "kubernetes/", "github.com/reddit/"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group kubernetes updates together",
      "matchManagers": ["gomod"],
      "matchPackagePrefixes": ["k8s.io/"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "kubernetes packages",
      "groupSlug": "kubernetes-go"
    },
    {
      "description": "Upgrade all kubernetes dependencies, including indirect ones",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Auto-merge patch updates to kubernetes packages",
      "matchManagers": ["gomod"],
      "matchPackagePrefixes": ["k8s.io/"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "rebaseWhen": "auto"
    },
  ],
}
